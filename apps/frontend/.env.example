# Demo DAA deployed on Sepolia testnet. Copy this file to .env to see this app in action with a test deployment.
# To use your own deployment, replace the values below after running your deploy script.

# Your deployed DAAToken contract address
VITE_DAA_TOKEN_ADDRESS=0x519DF0313070068099AD5f0911508A7EDFFD0fFD

# Your deployed DAARegistry contract address
VITE_DAA_REGISTRY_ADDRESS=0xabb7FF6f52Fc35CB3eC22C90Adbc53Ea0bFcB22e

# Chain ID: 11155111 for Sepolia, 1 for Ethereum mainnet
VITE_CHAIN_ID=11155111

# Block number when contracts were deployed (speeds up event log scanning)
VITE_DEPLOY_BLOCK=10799000

# Public RPC endpoint for your target network (you can use a public one, or something like Infura/Alchemy)
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Governance: Gnosis Safe address (both normalAuthority and coreAuthority point here)
VITE_SAFE_ADDRESS=0xd974DbbC38EF3ee876982ae185B0CBc3AD5aAD2e

# Snapshot X: on-chain governance space address (deployed via sx-evm ProxyFactory)
VITE_SX_SPACE_ADDRESS=0x34eb4e38ceafb5eb43065d6904aa20e527ddf587

# Execution strategies: normal (50% approval) and core (70% approval)
VITE_NORMAL_STRATEGY_ADDRESS=0x5acaceBe7c9a0cFE06D7CC4c01D82Bd1F74B24Ed
VITE_CORE_STRATEGY_ADDRESS=0x129cce1E03a59981fc15D1a6ED837952D0d0060f

# Snapshot X: EthTxAuthenticator address (deployed on your target network)
VITE_AUTHENTICATOR_ADDRESS=0xBA06E6cCb877C332181A6867c05c8b746A21Aed1

# Terms of membership (category + document pointing to the terms document in the registry)
# Leave empty if no terms document exists yet
VITE_TERMS_CATEGORY_ID=
VITE_TERMS_DOCUMENT_ID=

# Arweave uploads use the connected wallet via ArDrive Turbo. No private key needed — the proposer signs uploads through their wallet.
